rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Boletas: acceso para cualquier cuenta autenticada con Google.
    match /boletas/{numeroControl} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isPanelAdmin();
    }

    // Bitácora de consulta de boletas. Cada cuenta autenticada sólo puede
    // crear eventos que lleven su propia identidad; sólo un administrador del
    // panel puede revisarlos.
    match /boletaAccessLogs/{logId} {
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly([
          'evento', 'numeroControl', 'resultado', 'uid', 'email',
          'displayName', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow read: if isPanelAdmin();
      allow update, delete: if false;
    }

    // Horarios docentes: lectura solo docentes autorizados o admin
    match /horarios_docentes/{docId} {
      allow read: if isDocenteAutorizado() || isAdmin();
      allow create, update, delete: if esCorreoCetis50();
    }

    // Avisos internos docentes: lectura solo docentes autorizados o admin
    match /docentesAnnouncements/{docId} {
      allow read: if isDocenteAutorizado() || isAdmin();
      allow create, update, delete: if esCorreoCetis50();
    }

    // Avisos: públicos por categoría; alumnos requiere cuenta institucional
    match /announcements/{docId} {
      allow read: if isAvisoPublico() || (isAvisoAlumnos() && isCuentaInstitucional());
      allow create, update, delete: if esCorreoCetis50();
    }

    // Tutorías: lectura para cualquier cuenta institucional
    match /reportes_asistencia/{id} {
      allow read: if isCuentaInstitucional();
      allow create, update, delete: if esCorreoCetis50();
    }

    // Horarios (colección legacy/externa)
    match /horarios/{rfc} {
      allow read, create, update, delete: if esCorreoCetis50();
    }

    // Usuarios: los permisos administrativos sólo los puede otorgar un admin.
    match /users/{userId} {
      allow read: if isPanelAdmin() || isUserManager() || isOwnUserDoc(userId);
      allow create, update, delete: if isUserManager();
    }

    function esCorreoCetis50() {
      return request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email.matches('(?i)^.*@cetis50cdmx\\.(com|edu\\.mx)$');
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isCuentaInstitucional() {
      return esCorreoCetis50();
    }

    function avisoCategory() {
      return (resource.data.category is string)
        ? resource.data.category.lower()
        : '';
    }

    function isAvisoPublico() {
      return avisoCategory() in ['general', 'eventos', 'vinculacion', 'tutorias'];
    }

    function isAvisoAlumnos() {
      return avisoCategory() == 'alumnos';
    }

    function isAdmin() {
      return request.auth != null &&
        (request.auth.token.role == 'admin' ||
         request.auth.token.isAdmin == true);
    }

    // Cuenta inicial del proyecto: puede registrar a los demás administradores
    // desde el panel. No concede acceso administrativo a alumnos.
    function isBootstrapAdmin() {
      return request.auth != null &&
        request.auth.token.email == 'luisalfonsomartinez@cetis50cdmx.com';
    }

    // Sólo estas cuentas pueden dar o retirar privilegios desde Gestión de
    // Usuarios. Los demás administradores conservan sus funciones operativas.
    function isUserManager() {
      return request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email in [
          'lmartinez@cetis50cdmx.edu.mx',
          'luisalfonsomartinez@cetis50cdmx.com'
        ];
    }

    function isPanelAdmin() {
      return isAdmin() || isBootstrapAdmin() || (
        request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.canPublish == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.canPublishDocentes == true
        )
      );
    }

    function isDocentePorClaim() {
      return request.auth != null &&
        isCuentaInstitucional() &&
        (
          request.auth.token.role == 'docente' ||
          request.auth.token.isDocente == true
        );
    }

    function isDocenteEnUsersUid() {
      return request.auth != null &&
        isCuentaInstitucional() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.esDocente == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isDocente == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'docente'
        );
    }

    function isDocenteAutorizado() {
      return isDocentePorClaim() || isDocenteEnUsersUid();
    }

    function isOwnUserDoc(userId) {
      return request.auth != null &&
        esCorreoCetis50() &&
        (
          request.auth.uid == userId ||
          (
            request.auth.token.email != null &&
            resource.data.email != null &&
            request.auth.token.email.lower() == resource.data.email.lower()
          )
        );
    }
  }
}
