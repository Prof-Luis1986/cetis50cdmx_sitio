rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Boletas: acceso para cualquier cuenta institucional
    match /boletas/{numeroControl} {
      allow read: if isCuentaInstitucional();
      allow create, update, delete: if esCorreoCetis50();
    }

    // Horarios docentes: lectura solo docentes autorizados o admin
    match /horarios_docentes/{docId} {
      allow read: if isDocenteAutorizado() || isAdmin();
      allow create, update, delete: if esCorreoCetis50();
    }

    // Avisos internos docentes: lectura solo docentes autorizados o admin
    match /docentesAnnouncements/{docId} {
      allow read: if isDocenteAutorizado() || isAdmin();
      allow create, update, delete: if esCorreoCetis50();
    }

    // Avisos públicos (alumnos y visitantes)
    match /announcements/{docId} {
      allow read: if true;
      allow create, update, delete: if esCorreoCetis50();
    }

    // Tutorías: lectura para cualquier cuenta institucional
    match /reportes_asistencia/{id} {
      allow read: if isCuentaInstitucional();
      allow create, update, delete: if esCorreoCetis50();
    }

    // Horarios (colección legacy/externa)
    match /horarios/{rfc} {
      allow read, create, update, delete: if esCorreoCetis50();
    }

    // Usuarios: cada cuenta gestiona su propio documento; admin puede gestionar todos
    match /users/{userId} {
      allow read: if isAdmin() || isOwnUserDoc(userId);
      allow create, update: if isAdmin() || (esCorreoCetis50() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    function esCorreoCetis50() {
      return request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email.matches('(?i)^.*@cetis50cdmx\\.(com|edu\\.mx)$');
    }

    function isCuentaInstitucional() {
      return esCorreoCetis50();
    }

    function isAdmin() {
      return request.auth != null &&
        (request.auth.token.role == 'admin' ||
         request.auth.token.isAdmin == true);
    }

    function isDocentePorClaim() {
      return request.auth != null &&
        isCuentaInstitucional() &&
        (
          request.auth.token.role == 'docente' ||
          request.auth.token.isDocente == true
        );
    }

    function isDocenteEnUsersUid() {
      return request.auth != null &&
        isCuentaInstitucional() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.esDocente == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isDocente == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'docente'
        );
    }

    function isDocenteAutorizado() {
      return isDocentePorClaim() || isDocenteEnUsersUid();
    }

    function isOwnUserDoc(userId) {
      return request.auth != null &&
        esCorreoCetis50() &&
        (
          request.auth.uid == userId ||
          (
            request.auth.token.email != null &&
            resource.data.email != null &&
            request.auth.token.email.lower() == resource.data.email.lower()
          )
        );
    }
  }
}
